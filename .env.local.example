# Supabase — create a new project at supabase.com and paste values here
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: locks the daily digest cron endpoint (set the same value in Vercel)
CRON_SECRET=any-random-string

# Account Pursuit agents — FREE AI providers (set at least one; they fall back in this order)
# Get keys: aistudio.google.com/apikey | console.groq.com/keys | openrouter.ai/keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional overrides if a free model name changes
# LLM_ORDER=gemini,groq,openrouter
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
